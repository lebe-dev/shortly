# Shortly Environment Variables Configuration
#
# Copy this file to .env and uncomment/modify values as needed
# These variables override values from config.yml
#
# Usage with docker-compose:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your values
#   3. Run: docker-compose up -d
#
# The .env file will be automatically loaded by docker-compose

# Server bind address
# Default: 0.0.0.0:8080
#BIND=0.0.0.0:8080

# Logging level: debug, info, warn, error
# Default: info
#LOG_LEVEL=info

# Logging target: console, file
# Default: file
#LOG_TARGET=file

# SQLite database connection string
# Default: sqlite://./data/app.db?mode=rwc
#DB_CNN=sqlite://./data/app.db?mode=rwc

# Base URL for generating short links
# IMPORTANT: Set this to your actual domain
# Default: https://shortly.company.com
#BASE_URL=https://shortly.company.com

# Link time-to-live in hours
# Default: 168 (7 days)
#SHORT_URL_TTL=168

# Cron expression for cleaning up expired URLs
# Format: "sec min hour day-of-month month day-of-week"
# Default: 0 0 0 * * * (every day at midnight)
#SCHEDULER_CLEANUP_EXPIRED_URLS=0 0 0 * * *
