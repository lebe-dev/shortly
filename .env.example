# Shortly Environment Variables Configuration
#
# Copy this file to .env and uncomment/modify values as needed
# These variables override values from config.yml
#
# Usage with docker-compose:
#   1. Copy: cp .env.example .env
#   2. Edit .env with your values
#   3. Run: docker-compose up -d
#
# The .env file will be automatically loaded by docker-compose

# Server bind address
# Default: 0.0.0.0:8080
#BIND=0.0.0.0:8080

# Logging level: debug, info, warn, error
# Default: info
#LOG_LEVEL=info

# Logging target: console, file
# Default: file
#LOG_TARGET=file

# SQLite database connection string
# Default: sqlite://./data/app.db?mode=rwc
#DB_CNN=sqlite://./data/app.db?mode=rwc

# Base URL for generating short links
# IMPORTANT: Set this to your actual domain
# Default: https://shortly.company.com
#BASE_URL=https://shortly.company.com

# Link time-to-live in hours
# Default: 168 (7 days)
#SHORT_URL_TTL=168

# Maximum length of original URL in characters
# Default: 2048
#SHORT_URL_MAX_LENGTH=2048

# Cron expression for cleaning up expired URLs
# Format: "sec min hour day-of-month month day-of-week"
# Default: 0 0 0 * * * (every day at midnight)
#SCHEDULER_CLEANUP_EXPIRED_URLS=0 0 0 * * *

# ============================================
# Feature Flags
# ============================================

# Enable/disable URL creation feature
# Default: true
#FEATURES_CREATE_URL_ENABLED=true

# Require authentication for creating URLs
# Default: false
#FEATURES_CREATE_URL_AUTH_ONLY=false

# Maximum number of URLs a user can create (0 = unlimited)
# Default: 0
#FEATURES_CREATE_URL_MAX_PER_USER=0

# Maximum number of URLs a user can create per day (0 = unlimited)
# Default: 0
#FEATURES_CREATE_URL_MAX_PER_DAY=0

# Enable/disable custom named URLs feature
# Default: false
#FEATURES_NAMED_URLS_ENABLED=false

# Minimum length for custom named URLs
# Default: 3
#FEATURES_NAMED_URLS_MIN_LENGTH=3

# Maximum length for custom named URLs
# Default: 50
#FEATURES_NAMED_URLS_MAX_LENGTH=50

# ============================================
# Authentication Configuration
# ============================================

# Enable/disable authentication
# Default: false
#AUTH_ENABLED=false

# Authentication type: gitlab
# Default: gitlab
#AUTH_TYPE=gitlab

# GitLab OAuth base URL
# Default: https://gitlab.com
#AUTH_PROVIDERS_GITLAB_BASE_URL=https://gitlab.com

# GitLab OAuth Application ID
# Required if AUTH_ENABLED=true
#AUTH_PROVIDERS_GITLAB_APPLICATION_ID=

# GitLab OAuth Application Secret
# Required if AUTH_ENABLED=true
#AUTH_PROVIDERS_GITLAB_SECRET=

# Authentication note/message displayed to users
#AUTH_NOTE=

# Comma-separated list of admin usernames
# Example: user1,user2,user3
#AUTH_ADMIN_USERS=

# ============================================
# Monitoring & Metrics
# ============================================

# Enable/disable Prometheus metrics endpoint at /api/metrics
# Default: false
#METRICS_ENABLED=false
