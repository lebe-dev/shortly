# Shortly Configuration File
#
# All values can be overridden using environment variables.
# Environment variables have HIGHER priority than values in this file.
#
# Environment variable naming:
#   - Top-level fields: UPPERCASE (e.g., BIND, LOG_LEVEL)
#   - Nested fields: PARENT_CHILD (e.g., SHORT_URL_TTL, SCHEDULER_CLEANUP_EXPIRED_URLS)
#
# Example: Override server bind address
#   export BIND="0.0.0.0:9090"

# Server bind address (ENV: BIND)
bind: "0.0.0.0:8080"

# Logging level: debug, info, warn, error (ENV: LOG_LEVEL)
log-level: info
# Logging target: console, file (ENV: LOG_TARGET)
log-target: file

# Database connection string (ENV: DB_CNN)
#
# Supported databases:
#   - SQLite:     sqlite://./data/app.db?mode=rwc
#   - PostgreSQL: postgres://user:password@host:5432/database
#
# The database type is automatically detected from the connection string prefix.
#
# SQLite is recommended for:
#   - Single-instance deployments
#   - Development and testing
#   - Low to moderate traffic
#
# PostgreSQL is recommended for:
#   - Production deployments
#   - High availability setups
#   - Multi-instance/clustered deployments
#
db-cnn: "sqlite://./data/app.db?mode=rwc"

# Base URL for generating short links (ENV: BASE_URL)
base-url: "https://shortly.company.com"

# Feature flags for application functionality
features:
  create-url:
    # Enable/disable URL creation endpoint (ENV: FEATURES_CREATE_URL_ENABLED)
    enabled: true
    # Require authentication to create URLs (ENV: FEATURES_CREATE_URL_AUTH_ONLY)
    auth-only: true

    # Fallback limits for users without their own quotas.
    #
    # Quotas assigned to a user by an administrator (admin panel /
    # POST /api/user/{user_id}/quotas) always take precedence over the values
    # below. New users get the database defaults: 100 total / 10 per day.
    #
    # Maximum URLs per user (ENV: FEATURES_CREATE_URL_MAX_PER_USER)
    max-per-user: 100
    # Maximum URLs per day (ENV: FEATURES_CREATE_URL_MAX_PER_DAY)
    max-per-day: 10

  named-urls:
    # Enable/disable custom named URLs (ENV: FEATURES_NAMED_URLS_ENABLED)
    enabled: true
    # Minimum length for custom names (ENV: FEATURES_NAMED_URLS_MIN_LENGTH)
    min-length: 3
    # Maximum length for custom names (ENV: FEATURES_NAMED_URLS_MAX_LENGTH)
    max-length: 32

    # Reserved names that cannot be used
    # Note: The following names are ALWAYS reserved (hardcoded in application):
    #   links, api, login, logout, assets, static, health, metrics, auth, admin
    # You can add additional custom reserved names below:
    reserved-names: []
      # Examples of additional names you might want to reserve:
      # - admin-panel
      # - dashboard
      # - settings
      # - profile

# Authentication configuration
#
# Passkey (WebAuthn) login is configured through environment variables only,
# see .env-dist and docs/configuration/passkey.md.
auth:
  # Enable/disable authentication (ENV: AUTH_ENABLED)
  enabled: true

  # Authentication provider type: gitlab (ENV: AUTH_TYPE)
  type: gitlab

  # Optional note to display on login page (ENV: AUTH_NOTE)
  # Use this to communicate requirements like "VPN must be enabled"
  note: ""

  admin-users: "admin-user1,admin-user2"

  providers:
    gitlab:
      # GitLab instance base URL (ENV: AUTH_PROVIDERS_GITLAB_BASE_URL)
      base-url: https://gitlab.com
      # GitLab OAuth application ID (ENV: AUTH_PROVIDERS_GITLAB_APPLICATION_ID)
      application-id: CHANGE-ME
      # GitLab OAuth application secret (ENV: AUTH_PROVIDERS_GITLAB_SECRET)
      secret: CHANGE-ME

short-url:
  # Link TTL in hours (ENV: SHORT_URL_TTL)
  ttl: 168 # 7 days
  # Maximum URL length in characters (ENV: SHORT_URL_MAX_LENGTH)
  max-length: 2048

scheduler:
  # Cron expression for cleanup job (ENV: SCHEDULER_CLEANUP_EXPIRED_URLS)
  # Format: "sec min hour day-of-month month day-of-week"
  cleanup-expired-urls: "0 0 0 * * *" # Every day at midnight

metrics:
  enabled: true
