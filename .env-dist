# Environment variables for Shortly.
#
# Copy this file to .env, it is loaded at startup and overrides config.yml.
# The .env file is ignored by git, keep secrets there.

# --- Passkey (WebAuthn) authentication -------------------------------------
#
# Passkeys are configured through the environment only, there is nothing about
# them in config.yml. Login with a passkey works for existing accounts only:
# a user first signs in with GitLab and adds a passkey on the profile page.
#
# WebAuthn requires a secure context: HTTPS, or http://localhost during
# development.

# Enable login with a passkey (true / false)
PASSKEY_ENABLED=false
# Relying party ID: the registrable domain, without scheme or port
PASSKEY_RP_ID=shortly.company.com
# Origin the browser reports, including scheme and port
PASSKEY_RP_ORIGIN=https://shortly.company.com
# Name shown by the authenticator (optional, default: Shortly)
PASSKEY_RP_NAME=Shortly
# Lifetime of an unfinished registration or login, in seconds (optional, default: 300)
PASSKEY_CHALLENGE_TTL=300

# --- Other settings --------------------------------------------------------
#
# Every variable from docs/configuration/env.md may be set here as well, for
# example:
#
# BASE_URL=https://shortly.company.com
# AUTH_PROVIDERS_GITLAB_SECRET=change-me
